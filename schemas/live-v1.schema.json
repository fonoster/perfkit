                  "p99LatencyMs": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "failedCallsPct": {
                    "type": "number",
                    "minimum": 0
                  },
                  "confirmSteps": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "p99LatencyMs",
                  "failedCallsPct"
                ],
                "additionalProperties": false
              },
              "current": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "index": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "total": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "offeredCps": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "index",
                      "total",
                      "offeredCps"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "offeredCps": {
                      "type": "number",
                      "minimum": 0
                    },
                    "achievedCps": {
                      "type": "number",
                      "minimum": 0
                    },
                    "calls": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "failed": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "p50Ms": {
                      "type": "number",
                      "minimum": 0
                    },
                    "p95Ms": {
                      "type": "number",
                      "minimum": 0
                    },
                    "p99Ms": {
                      "type": "number",
                      "minimum": 0
                    },
                    "failedPct": {
                      "type": "number",
                      "minimum": 0
                    },
                    "ok": {
                      "type": "boolean"
                    },
                    "stopReason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "offeredCps",
                    "achievedCps",
                    "calls",
                    "failed",
                    "p50Ms",
                    "p95Ms",
                    "p99Ms",
                    "failedPct",
                    "ok",
                    "stopReason"
                  ],
                  "additionalProperties": false
                }
              },
              "heldCps": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "result": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "limitCps": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": 0
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "lowerBound": {
                        "type": "boolean"
                      },
                      "stopReason": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "limitCps",
                      "lowerBound",
                      "stopReason"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
