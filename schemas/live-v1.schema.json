              "id",
              "title",
              "unit",
              "state",
              "startedAt",
              "loadStartedAt",
              "estimatedStartAt",
              "plannedS",
              "kind",
              "rate",
              "thresholds",
              "current",
              "points",
              "heldCps",
              "result"
            ],
            "additionalProperties": false
          },
          {
