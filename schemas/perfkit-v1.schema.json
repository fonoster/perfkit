{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "perfkit/v1"
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "pattern": "^[\\w.-]+\\/[\\w.-]+$"
        },
        "siteUrl": {
          "type": "string",
          "format": "uri"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "logo": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "lead": {
          "type": "string",
          "minLength": 1
        },
        "live": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "repo",
        "siteUrl",
        "accent",
        "title",
        "lead"
      ],
      "additionalProperties": false
    },
    "infra": {
      "type": "object",
      "properties": {
        "provider": {
          "default": "digitalocean",
          "type": "string",
          "const": "digitalocean"
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "uut": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "size"
          ],
          "additionalProperties": false
        },
        "loadgen": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "size"
          ],
          "additionalProperties": false
        },
        "maxLifetime": {
          "default": "9h",
          "type": "string",
          "pattern": "^\\d+[smh]$"
        }
      },
      "required": [
        "region",
        "uut",
        "loadgen"
      ],
      "additionalProperties": false
    },
    "live": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
        },
        "port": {
          "default": 8787,
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "images": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "tagSuffix": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              }
            },
            "required": [
              "name",
              "tagSuffix"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "benchmarks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "kind": {
                "type": "string",
                "const": "capacity"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "narrative": {
                "type": "object",
                "properties": {
                  "what": {
                    "type": "string",
                    "minLength": 1
                  },
                  "why": {
                    "type": "string",
                    "minLength": 1
                  },
                  "how": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "what",
                  "why",
                  "how"
                ],
                "additionalProperties": false
              },
              "warmup": {
                "default": "0s",
                "type": "string",
                "pattern": "^\\d+[smh]$"
              },
              "uut": {
                "type": "object",
                "properties": {
                  "compose": {
                    "type": "string",
                    "minLength": 1
                  },
                  "setup": {
                    "type": "string",
                    "minLength": 1
                  },
                  "processes": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "match": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "name",
                        "match"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "compose",
                  "processes"
                ],
                "additionalProperties": false
              },
              "load": {
                "type": "object",
                "properties": {
                  "tool": {
                    "type": "string",
                    "const": "sipp"
                  },
                  "transport": {
                    "type": "string",
                    "const": "udp"
                  },
                  "port": {
                    "default": 5060,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "uac": {
                    "type": "object",
                    "properties": {
                      "scenario": {
                        "type": "string",
                        "minLength": 1
                      },
                      "users": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "scenario"
                    ],
                    "additionalProperties": false
                  },
                  "hold": {
                    "default": "0s",
                    "type": "string",
                    "pattern": "^\\d+[smh]$"
                  },
                  "unit": {
                    "default": "calls",
                    "type": "string",
                    "pattern": "^[a-z]+$"
                  },
                  "rate": {
                    "type": "object",
                    "properties": {
                      "start": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "step": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "every": {
                        "type": "string",
                        "pattern": "^\\d+[smh]$"
                      },
                      "max": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": [
                      "start",
                      "step",
                      "every",
                      "max"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "tool",
                  "transport",
                  "uac",
                  "rate"
                ],
                "additionalProperties": false
              },
              "telemetry": {
                "default": {
                  "otlp": false,
                  "sampleRatio": 0.01
                },
                "type": "object",
                "properties": {
                  "otlp": {
                    "type": "boolean"
                  },
                  "sampleRatio": {
                    "default": 0.01,
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "otlp"
                ],
                "additionalProperties": false
              },
              "thresholds": {
                "type": "object",
                "properties": {
                  "p99LatencyMs": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "failedCallsPct": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "p99LatencyMs",
                  "failedCallsPct"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "kind",
              "title",
              "narrative",
              "uut",
              "load",
              "thresholds"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "kind": {
                "type": "string",
                "const": "soak"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "narrative": {
                "type": "object",
                "properties": {
                  "what": {
                    "type": "string",
                    "minLength": 1
                  },
                  "why": {
                    "type": "string",
                    "minLength": 1
                  },
                  "how": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "what",
                  "why",
                  "how"
                ],
                "additionalProperties": false
              },
              "duration": {
                "type": "string",
                "pattern": "^\\d+[smh]$"
              },
              "warmup": {
                "type": "string",
                "pattern": "^\\d+[smh]$"
              },
              "uut": {
                "type": "object",
                "properties": {
                  "compose": {
                    "type": "string",
                    "minLength": 1
                  },
                  "setup": {
                    "type": "string",
                    "minLength": 1
                  },
                  "processes": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "match": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "name",
                        "match"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "compose",
                  "processes"
                ],
                "additionalProperties": false
              },
              "load": {
                "type": "object",
                "properties": {
                  "tool": {
                    "type": "string",
                    "const": "sipp"
                  },
                  "transport": {
                    "type": "string",
                    "const": "udp"
                  },
                  "port": {
                    "default": 5060,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "uac": {
                    "type": "object",
                    "properties": {
                      "scenario": {
                        "type": "string",
                        "minLength": 1
                      },
                      "users": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "scenario"
                    ],
                    "additionalProperties": false
                  },
                  "hold": {
                    "default": "0s",
                    "type": "string",
                    "pattern": "^\\d+[smh]$"
                  },
                  "unit": {
                    "default": "calls",
                    "type": "string",
                    "pattern": "^[a-z]+$"
                  },
                  "register": {
                    "type": "object",
                    "properties": {
                      "scenario": {
                        "type": "string",
                        "minLength": 1
                      },
                      "users": {
                        "type": "string",
                        "minLength": 1
                      },
                      "expires": {
                        "default": 300,
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "scenario",
                      "users"
                    ],
                    "additionalProperties": false
                  },
                  "uas": {
                    "type": "object",
                    "properties": {
                      "scenario": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "scenario"
                    ],
                    "additionalProperties": false
                  },
                  "rate": {
                    "type": "object",
                    "properties": {
                      "cps": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": [
                      "cps"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "tool",
                  "transport",
                  "uac",
                  "rate"
                ],
                "additionalProperties": false
              },
              "telemetry": {
                "default": {
                  "otlp": false,
                  "sampleRatio": 0.01
                },
                "type": "object",
                "properties": {
                  "otlp": {
                    "type": "boolean"
                  },
                  "sampleRatio": {
                    "default": 0.01,
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "otlp"
                ],
                "additionalProperties": false
              },
              "thresholds": {
                "type": "object",
                "properties": {
                  "memoryGrowthMBPerHour": {
                    "type": "number",
                    "minimum": 0
                  },
                  "failedCallsPct": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "restarts": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "memoryGrowthMBPerHour",
                  "failedCallsPct",
                  "restarts"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "kind",
              "title",
              "narrative",
              "duration",
              "warmup",
              "uut",
              "load",
              "thresholds"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "apiVersion",
    "project",
    "infra",
    "images",
    "benchmarks"
  ],
  "additionalProperties": false,
  "title": "perfkit.yaml v1",
  "description": "A project's benchmark definitions (apiVersion: perfkit/v1). Every path is relative to the directory of the perfkit.yaml file."
}
